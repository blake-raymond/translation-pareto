{
  "name": "translation-pareto",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Open cost-vs-quality benchmark of LLMs for conversational translation.",
  "scripts": {
    "test": "node --test eval/pareto/judge.test.mjs eval/pareto/data.test.mjs eval/pareto/frontier.test.mjs",
    "verify": "node eval/pareto/verify.mjs",
    "smoke": "node eval/pareto/smoke.mjs",
    "pareto:data": "node eval/pareto/data.mjs",
    "pareto:chat": "node eval/pareto/chat.mjs",
    "pareto:translate": "node eval/pareto/run-translate.mjs",
    "pareto:judge": "node eval/pareto/judge.mjs",
    "pareto:report": "node eval/pareto/report.mjs",
    "pareto:pilot": "node eval/pareto/run.mjs --pilot",
    "pareto:full": "node eval/pareto/run.mjs --full",
    "pareto:sanity": "node eval/pareto/sanity-all15.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
